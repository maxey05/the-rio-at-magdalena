# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase project URL (Supabase dashboard > Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon public key (Project Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key. Server only, never expose to the browser (Project Settings > API > service_role)
SUPABASE_SERVICE_ROLE_KEY=

# Gmail address that sends booking emails
GMAIL_USER=

# Gmail App Password for GMAIL_USER (Google Account > Security > App passwords)
GMAIL_APP_PASSWORD=

# Comma-separated emails allowed to sign in to /admin
ADMIN_EMAILS=

# Public base URL of the site, no trailing slash (http://localhost:3000 locally)
SITE_URL=http://localhost:3000

# draft hides the site from search engines, production allows indexing
SITE_ENV=draft

# Shared secret that the Netlify scheduled functions send to /api/cron/* routes
CRON_SECRET=
